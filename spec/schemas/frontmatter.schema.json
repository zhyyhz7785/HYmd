{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hymd.dev/schemas/frontmatter.schema.json",
  "title": "HyMD Frontmatter",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "title": {
      "type": "string",
      "description": "文档标题"
    },
    "theme": {
      "type": "string",
      "description": "主题名称"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["A0", "A1", "A2", "A3", "A4", "Letter"]
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "margin_mm": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "hymd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^0\\.\\d+$"
        }
      }
    }
  }
}
