{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run HyMD Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/hymd-vscode",
        "${workspaceFolder}/samples"
      ],
      "outFiles": ["${workspaceFolder}/packages/hymd-vscode/dist/**/*.js"]
    }
  ]
}
