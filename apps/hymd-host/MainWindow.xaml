<Window x:Class="HyMd.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HyMD Editor"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="600">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建(_N)" Click="OnNewClick" InputGestureText="Ctrl+N" />
                <MenuItem Header="打开(_O)..." Click="OnOpenClick" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="保存(_S)" Click="OnSaveClick" InputGestureText="Ctrl+S" />
                <MenuItem Header="另存为(_A)..." Click="OnSaveAsClick" />
                <Separator />
                <MenuItem Header="退出(_X)" Click="OnExitClick" />
            </MenuItem>
        </Menu>
        <Grid>
            <wv2:WebView2 x:Name="EditorWebView" />
            <Border x:Name="ReloadPrompt"
                    Background="#CC000000"
                    Visibility="Collapsed"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Padding="12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"
                               Text="文件已被外部修改。" />
                    <Button Content="重新加载" Click="OnReloadExternalClick" Margin="4,0" Padding="12,4" />
                    <Button Content="保留我的修改" Click="OnDismissReloadClick" Margin="4,0" Padding="12,4" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
