{
  "name": "hymd-editor",
  "displayName": "HyMD Editor",
  "description": "HyMD WYSIWYG editor powered by Milkdown Crepe",
  "version": "0.1.0",
  "publisher": "hymd",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onCustomEditor:hymd.editor"],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "hymd.editor",
        "displayName": "HyMD WYSIWYG",
        "selector": [
          { "filenamePattern": "*.hymd.md" }
        ],
        "priority": "default"
      },
      {
        "viewType": "hymd.editor",
        "displayName": "HyMD WYSIWYG",
        "selector": [
          { "filenamePattern": "*.md" }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "hymd.openWysiwyg",
        "title": "Open HyMD WYSIWYG Editor"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package:vsix": "npm run build && npx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "@hymd/parser": "*"
  },
  "devDependencies": {
    "@milkdown/crepe": "^7.15.1",
    "@milkdown/kit": "^7.15.1",
    "@milkdown/utils": "^7.15.1",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
